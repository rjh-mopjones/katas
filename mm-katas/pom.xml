<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.katas</groupId>
    <artifactId>mm-katas</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
      Market-making live-coding katas. One module, package com.katas.k<NN>_<slug>.

      Each kata escalates over four stages; Stage 1 is naive/single-threaded and later stages break
      the obvious Stage 1 design. Stage tests beyond Stage 1 are @Disabled — enable them (or let the
      ./kata runner do it) as you progress.

        ./kata 01                 # print Stage 1 spec + start the stopwatch
        ./kata 01 check           # run the current stage's tests; advance + reveal the next on green
        mvn -Dtest='com.katas.k01_orderbook.Stage1Test' test    # run one stage directly
        solutions/verify.sh 01    # prove the worked reference passes every stage
    -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.3</junit.version>
        <assertj.version>3.26.3</assertj.version>
        <surefire.version>3.5.2</surefire.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
